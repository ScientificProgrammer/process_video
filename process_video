# ------------------------------------------------------------------------------
# List / Verify Patterns (utility modes)
# ------------------------------------------------------------------------------

do_list_patterns() {
    printf '%s%s v%s -- Effective Pattern Set%s\n\n' \
        "${COLOR_BOLD_WHITE:-}" "$SCRIPT_NAME" "$SCRIPT_VERSION" "${COLOR_RESET:-}"

    printf '%sPreprocessing:%s\n' "${COLOR_BOLD_CYAN:-}" "${COLOR_RESET:-}"
    local p
    for p in "${DEFAULT_PREPROCESSING_PATTERNS[@]}"; do
        printf '  %s\n' "$p"
    done

    printf '\n%sAnalysis (%d patterns):%s\n' "${COLOR_BOLD_CYAN:-}" "${#OPT_PATTERNS[@]}" "${COLOR_RESET:-}"
    local idx=0
    for p in "${OPT_PATTERNS[@]}"; do
        ((idx++)) || true
        printf '  %2d. %s\n' "$idx" "$p"
    done

    printf '\n%sTotal API calls per video: %d%s\n' \
        "${COLOR_BOLD_WHITE:-}" "$(( ${#DEFAULT_PREPROCESSING_PATTERNS[@]} + ${#OPT_PATTERNS[@]} ))" "${COLOR_RESET:-}"
}

do_verify_patterns() {
    printf '%s%s v%s -- Pattern Verification%s\n\n' \
        "${COLOR_BOLD_WHITE:-}" "$SCRIPT_NAME" "$SCRIPT_VERSION" "${COLOR_RESET:-}"
    printf '%sPatterns directory:%s %s\n\n' \
        "${COLOR_BOLD_WHITE:-}" "${COLOR_RESET:-}" "$FABRIC_PATTERN_DIR"

    local all_patterns=("${DEFAULT_PREPROCESSING_PATTERNS[@]}" "${OPT_PATTERNS[@]}")
    local missing=0 pattern test_file

    printf '%-35s %s\n' "PATTERN" "STATUS"
    phdr

    for pattern in "${all_patterns[@]}"; do
        test_file="${FABRIC_PATTERN_DIR}/${pattern}/system.md"
        printf '%-35s ' "$pattern"
        if [[ -f "$test_file" ]]; then
            printf '%sFound%s\n' "${COLOR_GREEN:-}" "${COLOR_RESET:-}"
        else
            printf '%sNOT FOUND%s\n' "${COLOR_BOLD_RED:-}" "${COLOR_RESET:-}"
            ((missing++)) || true
        fi
    done

    phdr
    if [[ $missing -gt 0 ]]; then
        printf '%s%d pattern(s) missing%s\n' "${COLOR_BOLD_RED:-}" "$missing" "${COLOR_RESET:-}"
        exit 1
    else
        printf '%sAll %d patterns verified%s\n' "${COLOR_GREEN:-}" "${#all_patterns[@]}" "${COLOR_RESET:-}"
    fi
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------

RUN_START_TIME=""
RUN_START_SECONDS=0
ORIGINAL_ARGS=""

main() {
    ORIGINAL_ARGS="$*"
    RUN_START_SECONDS=$SECONDS
    RUN_START_TIME="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

    # Set up colors early so error messages during parse_args are colored
    setup_colors

    parse_args "$@"

    # Re-apply colors in case --no-color was specified
    OPT_NO_COLOR="$CLI_NO_COLOR"
    setup_colors

    # Load config if specified (need to do before resolve so CFG_* vars are set)
    if [[ -n "$CLI_CONFIG" ]]; then
        load_config "$CLI_CONFIG"
    fi

    # Resolve all options
    resolve_config

    # Re-apply colors in case resolve_config changed OPT_NO_COLOR
    setup_colors

    # Handle utility modes that don't require a video URL
    if [[ -n "$CLI_INIT_CONFIG" ]]; then
        do_init_config "$CLI_INIT_CONFIG"
        exit 0
    fi

    if [[ "$CLI_LIST_PATTERNS" == "true" ]]; then
        do_list_patterns
        exit 0
    fi

    if [[ "$CLI_VERIFY_PATTERNS" == "true" ]]; then
        check_dependencies
        do_verify_patterns
        exit 0
    fi

    # From here, we need a video URL
    if [[ -z "$VIDEO_INPUT" ]]; then
        die "YouTube URL or video ID is required. See --help."
    fi

    # Core setup
    check_dependencies
    check_optional_dependencies
    check_patterns_exist
    normalize_video_url "$VIDEO_INPUT"

    # Auto-generate session name if not specified
    if [[ -z "$OPT_SESSION" ]]; then
        OPT_SESSION="$(date '+%Y%m%d_%H%M%S').process_video.${VIDEO_ID}"
        debug "Auto-generated session: $OPT_SESSION"
    fi

    # Phase 1: Fetch metadata to generate the base filename
    # Use a temporary approach: first create a temp dir, fetch metadata,
    # then set up the real output dir with the proper name
    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        BASE_FILENAME="dryrun.${VIDEO_ID}"
        setup_output_dir
        fetch_metadata
        generate_llm_slug
        generate_base_filename
        info "[dry-run] Final output directory would be: ${PWD}/${BASE_FILENAME}"
    else
        # Create a temp directory for metadata fetch
        local tmp_meta_dir
        tmp_meta_dir="$(mktemp -d)"
        local tmp_meta_file="${tmp_meta_dir}/metadata.json"

        info "Fetching metadata..."
        local start_time=$SECONDS

        if ! fetch_metadata_to_file "$tmp_meta_file"; then
            rm -rf "$tmp_meta_dir"
            die "Failed to fetch video metadata. Check URL: $VIDEO_URL"
        fi

        parse_metadata_file "$tmp_meta_file"

        local elapsed=$(( SECONDS - start_time ))
        info "  Title:   $VIDEO_TITLE"
        info "  Channel: $CHANNEL_NAME"
        info "  Date:    $UPLOAD_DATE"
        info "  Metadata fetched $(format_duration $elapsed)"

        # Generate LLM slugs, then base filename, then set up output dir
        generate_llm_slug
        generate_base_filename
        setup_output_dir

        # Move metadata to its final location
        mv "$tmp_meta_file" "${OUTPUT_DIR}/config/${BASE_FILENAME}.metadata.json"
        rm -rf "$tmp_meta_dir"
    fi

    phdr "Processing: ${VIDEO_TITLE}"
    info "Output: $OUTPUT_DIR"
    info "Model: $OPT_MODEL | Patterns: ${#OPT_PATTERNS[@]} | Jobs: ${OPT_JOBS}"

    trap _cleanup_on_exit EXIT

    # Phase 2: Fetch and preprocess transcript
    fetch_transcript
    preprocess_transcript

    # Phase 3: Run all analysis patterns
    run_all_patterns

    # Phase 4: Assemble and convert report
    assemble_report
    run_editorial_pass
    convert_report
    convert_artifacts

    # Phase 5: Generate manifest and clean up
    generate_manifest
    cleanup

    # Final summary
    phdr
    local total_elapsed=$(( SECONDS - RUN_START_SECONDS ))
    info "Done in $(format_duration $total_elapsed)"
    if [[ "$OPT_NO_REPORT" != "true" ]]; then
        info "Report: ${OUTPUT_DIR}/${BASE_FILENAME}.report.md"
    fi
    info "Output: $OUTPUT_DIR"
    phdr
}

# ------------------------------------------------------------------------------
# Entry Point
# ------------------------------------------------------------------------------

main "$@"
