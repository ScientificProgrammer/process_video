#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# process_video -- YouTube Transcript Processing CLI
#
# Extract YouTube video transcripts and process them through fabric patterns
# to generate structured analysis reports.
#
# Usage: process_video [OPTIONS] <YOUTUBE_URL_OR_ID>
#        process_video --help
#
# Version: Derived from git tags at runtime (see --version)
# Dependencies: fabric (required), jq (required), pandoc (optional), yt-dlp (optional)
# ------------------------------------------------------------------------------

# Sourcing guard: this script must be executed, not sourced
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    printf "ERROR: This script must be executed, not sourced.\n" >&2
    return 1
fi

set -euo pipefail

