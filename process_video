#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# process_video -- YouTube Transcript Processing CLI
#
# Extract YouTube video transcripts and process them through fabric patterns
# to generate structured analysis reports.
#
# Usage: process_video [OPTIONS] <YOUTUBE_URL_OR_ID>
#        process_video --help
#
# Version: Derived from git tags at runtime (see --version)
# Dependencies: fabric (required), jq (required), pandoc (optional), yt-dlp (optional)
# ------------------------------------------------------------------------------

# Sourcing guard: this script must be executed, not sourced
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    printf "ERROR: This script must be executed, not sourced.\n" >&2
    return 1
fi

set -euo pipefail

# ------------------------------------------------------------------------------
# Constants (kept in main script: depend on BASH_SOURCE[0])
# ------------------------------------------------------------------------------

# Version from git tags (falls back to "dev" if not in a git repo or no tags)
get_version() {
    local version
    if version="$(git -C "$(dirname "${BASH_SOURCE[0]}")" describe --tags --always 2>/dev/null)"; then
        printf '%s' "$version"
    else
        printf 'dev'
    fi
}

# shellcheck disable=SC2155  # Intentional: get_version is simple and won't fail
readonly SCRIPT_VERSION="$(get_version)"
readonly SCRIPT_NAME="process_video"
# shellcheck disable=SC2155,SC2034  # May be used in future; pwd won't fail
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ------------------------------------------------------------------------------
# Module sourcing: load lib/ modules in dependency order
# ------------------------------------------------------------------------------
readonly _LIB_DIR="${SCRIPT_DIR}/lib"
if [[ ! -d "$_LIB_DIR" ]]; then
    printf 'FATAL: lib/ directory not found at %s\n' "$_LIB_DIR" >&2
    exit 1
fi

# Source order matters — each module may depend on those sourced before it.
# shellcheck source=lib/constants.sh
source "${_LIB_DIR}/constants.sh"
# shellcheck source=lib/ui.sh
source "${_LIB_DIR}/ui.sh"
# shellcheck source=lib/cli.sh
source "${_LIB_DIR}/cli.sh"
# shellcheck source=lib/config.sh
source "${_LIB_DIR}/config.sh"
# shellcheck source=lib/deps.sh
source "${_LIB_DIR}/deps.sh"
# shellcheck source=lib/video.sh
source "${_LIB_DIR}/video.sh"
# shellcheck source=lib/processing.sh
source "${_LIB_DIR}/processing.sh"
# shellcheck source=lib/output.sh
source "${_LIB_DIR}/output.sh"
# shellcheck source=lib/utility.sh
source "${_LIB_DIR}/utility.sh"

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------

RUN_START_TIME=""
RUN_START_SECONDS=0
ORIGINAL_ARGS=""

main() {
    ORIGINAL_ARGS="$*"
    RUN_START_SECONDS=$SECONDS
    RUN_START_TIME="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

    # Set up colors early so error messages during parse_args are colored
    setup_colors

    parse_args "$@"

    # Re-apply colors in case --no-color was specified
    OPT_NO_COLOR="$CLI_NO_COLOR"
    setup_colors

    # Load config if specified (need to do before resolve so CFG_* vars are set)
    if [[ -n "$CLI_CONFIG" ]]; then
        load_config "$CLI_CONFIG"
    fi

    # Resolve all options
    resolve_config

    # Re-apply colors in case resolve_config changed OPT_NO_COLOR
    setup_colors

    # Handle utility modes that don't require a video URL
    if [[ -n "$CLI_INIT_CONFIG" ]]; then
        do_init_config "$CLI_INIT_CONFIG"
        exit 0
    fi

    if [[ "$CLI_LIST_PATTERNS" == "true" ]]; then
        do_list_patterns
        exit 0
    fi

    if [[ "$CLI_VERIFY_PATTERNS" == "true" ]]; then
        check_dependencies
        do_verify_patterns
        exit 0
    fi

    # From here, we need a video URL
    if [[ -z "$VIDEO_INPUT" ]]; then
        die "YouTube URL or video ID is required. See --help."
    fi

    # Core setup
    check_dependencies
    check_optional_dependencies
    check_patterns_exist
    normalize_video_url "$VIDEO_INPUT"

    # Auto-generate session name if not specified
    if [[ -z "$OPT_SESSION" ]]; then
        OPT_SESSION="$(date '+%Y%m%d_%H%M%S').process_video.${VIDEO_ID}"
        debug "Auto-generated session: $OPT_SESSION"
    fi

    # Phase 1: Fetch metadata to generate the base filename
    # Use a temporary approach: first create a temp dir, fetch metadata,
    # then set up the real output dir with the proper name
    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        BASE_FILENAME="dryrun.${VIDEO_ID}"
        setup_output_dir
        fetch_metadata
        generate_llm_slug
        generate_base_filename
        info "[dry-run] Final output directory would be: ${PWD}/${BASE_FILENAME}"
    else
        # Create a temp directory for metadata fetch
        local tmp_meta_dir
        tmp_meta_dir="$(mktemp -d)"
        local tmp_meta_file="${tmp_meta_dir}/metadata.json"

        info "Fetching metadata..."
        local start_time=$SECONDS

        if ! fetch_metadata_to_file "$tmp_meta_file"; then
            rm -rf "$tmp_meta_dir"
            die "Failed to fetch video metadata. Check URL: $VIDEO_URL"
        fi

        parse_metadata_file "$tmp_meta_file"

        local elapsed=$(( SECONDS - start_time ))
        info "  Title:   $VIDEO_TITLE"
        info "  Channel: $CHANNEL_NAME"
        info "  Date:    $UPLOAD_DATE"
        info "  Metadata fetched $(format_duration $elapsed)"

        # Generate LLM slugs, then base filename, then set up output dir
        generate_llm_slug
        generate_base_filename
        setup_output_dir

        # Move metadata to its final location
        mv "$tmp_meta_file" "${OUTPUT_DIR}/config/${BASE_FILENAME}.metadata.json"
        rm -rf "$tmp_meta_dir"
    fi

    phdr "Processing: ${VIDEO_TITLE}"
    info "Output: $OUTPUT_DIR"
    info "Model: $OPT_MODEL | Patterns: ${#OPT_PATTERNS[@]} | Jobs: ${OPT_JOBS}"

    trap _cleanup_on_exit EXIT

    # Phase 2: Fetch and preprocess transcript
    fetch_transcript
    preprocess_transcript

    # Phase 3: Run all analysis patterns
    run_all_patterns

    # Phase 4: Assemble and convert report
    assemble_report
    run_editorial_pass
    convert_report
    convert_artifacts

    # Phase 5: Generate manifest and clean up
    generate_manifest
    cleanup

    # Final summary
    phdr
    local total_elapsed=$(( SECONDS - RUN_START_SECONDS ))
    info "Done in $(format_duration $total_elapsed)"
    if [[ "$OPT_NO_REPORT" != "true" ]]; then
        info "Report: ${OUTPUT_DIR}/${BASE_FILENAME}.report.md"
    fi
    info "Output: $OUTPUT_DIR"
    phdr
}

# ------------------------------------------------------------------------------
# Entry Point
# ------------------------------------------------------------------------------

main "$@"
